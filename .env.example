# LLM Backend
SYNTHARA_API_TYPE=ollama
# Options: ollama | openai
# For ollama (local):
OLLAMA_URL=http://localhost:11434
# For openai-compatible (Groq, Together, etc.):
SYNTHARA_OPENAI_BASE=https://api.groq.com/openai/v1
SYNTHARA_OPENAI_KEY=gsk_your_key_here

# Models
SYNTHARA_ORCHESTRATOR_MODEL=qwen3:latest
# With OpenAI: use "mixtral-8x7b-32768" for Groq
SYNTHARA_WORKER_MODEL=qwen3:latest

# Server
SYNTHARA_SECRET_KEY=change-this-in-production
SYNTHARA_API_KEY=sk-synthara-dev
SYNTHARA_DB_PATH=synthara.db
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Crypto
SYNTHARA_WALLET=
# Your Solana wallet address for receiving payments
